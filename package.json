{
  "name": "llamarun",
  "productName": "Llama Run",
  "version": "0.4.0",
  "description": "An AI-powered desktop assistant with Python plugins, MCP and local/cloud LLMs.",
  "main": "./out/main/index.js",
  "author": "Krish Baidya",
  "license": "GPL-3.0",
  "homepage": "https://github.com/krishbaidya/LlamaRun",
  "private": true,
  "scripts": {
    "postinstall": "install-electron && node scripts/fetch-python.mjs",
    "fetch-python": "node scripts/fetch-python.mjs",
    "sync-models": "node scripts/sync-models.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:sdk": "node scripts/test-sdk.mjs",
    "build:win": "npm run build && electron-builder --win",
    "build:unpack": "npm run build && electron-builder --dir",
    "bundle-plugins": "node scripts/bundle-plugins.mjs",
    "build:release": "npm run bundle-plugins && npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild-wasm": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "ollama": "^0.6.3",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "unpdf": "^1.9.1",
    "zod": "^4.6.5"
  }
}
